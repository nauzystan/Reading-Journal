<%- include("partials/header") %>

<div class="container">

    <!-- ======================
         ADD / EDIT BOOK FORM
         ====================== -->

    <section class="form-page">

        <!-- Dynamic page title based on whether
             user is creating or editing a review -->

        <h1 class="form-title">
            <%= bookData ? "✏️ Edit Book Review" : "📚 Add New Book" %>
        </h1>

        <!-- Navigation back to homepage -->

        <a href="/" class="back-link">← Back to Library</a>

        <!-- Form submits to either
             /add or /edit/:id -->

        <form action="<%= bookData ? '/edit/' + bookData.id : '/add' %>"
              method="POST"
              class="book-form">

            <!-- ======================
                 BOOK TITLE SEARCH
                 Uses Open Library API
                 ====================== -->

            <label>Title</label>

            <input
                type="text"
                id="bookSearch"
                name="title"
                value="<%= bookData ? bookData.title : '' %>"
                required>

            <!-- Live search results appear here -->

            <div id="searchResults"></div>

            <!-- ======================
                 AUTHOR
                 ====================== -->

            <label>Author</label>

            <input
                type="text"
                name="author"
                value="<%= bookData ? bookData.author : '' %>"
                required>

            <!-- ======================
                 COVER ID
                 Hidden because it is
                 automatically filled
                 from Open Library search
                 ====================== -->

            <!-- <label>Cover ID</label> -->

            <input
                type="hidden"
                name="coverId"
                value="<%= bookData ? bookData.cover_id : '' %>">

            <!-- Cover preview appears here -->

            <div id="coverPreview"></div>

            <!-- ======================
                 RATING
                 ====================== -->

            <label>Rating (1-10)</label>

            <input
                type="number"
                min="1"
                max="10"
                name="rating"
                value="<%= bookData ? bookData.rating : '' %>"
                required>

            <!-- ======================
                 DATE FINISHED READING
                 Optional field
                 ====================== -->

            <label>Date Read</label>

            <input
                type="date"
                name="dateRead"
                value="<%= bookData && bookData.date_read
          ? new Date(bookData.date_read).toISOString().split('T')[0]
          : '' %>">

            <!-- ======================
                 REVIEW / NOTES
                 ====================== -->

            <label>Your Notes</label>

            <p class="notes-help">
                Share your thoughts, favourite quotes, lessons learned, or a full review.
            </p>

            <textarea
                name="notes"
                rows="30"
                required><%= bookData ? bookData.notes : '' %></textarea>

            <!-- Live character counter -->

            <p id="charCount">0 characters</p>

            <!-- ======================
                 SUBMIT BUTTON
                 ====================== -->

            <button type="submit" class="btn-save">

                <%= bookData ? "Update Review" : "Save Review" %>

            </button>

        </form>

    </section>

</div>

<!-- ======================
     SEARCH + COVER PREVIEW
     + CHARACTER COUNTER
     ====================== -->

<script src="/js/search.js"></script>

<%- include("partials/footer") %>
